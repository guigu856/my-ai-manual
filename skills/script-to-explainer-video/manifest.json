  "status": "active",
  "maturity_tier": "production",
  "lifecycle_stage": "production",
  "context_budget_tier": "production",
  "review_cadence": "on-change",
  "intent": {
    "job_to_be_done": "把脚本、工作流、口播稿或概念 brief 转成以配音为主时钟的概念动效解说视频，并输出可审查的生产交接包。",
    "target_users": [
      "视频创作者",
      "知识视频制作代理",
      "Remotion 或 HyperFrames 实现者"
    ],
    "inputs": [
      "口播脚本、观点文案、工作流、产品说明或概念 brief",
      "平台、比例、帧率、声线、视觉风格和交付格式（可选）",
      "已有 Remotion / HyperFrames 工程与资源（可选）"
    ],
    "outputs": [
      "冻结后的 segments.json",
      "实测配音、句级 cue、canonical timeline.json 和字幕数据",
      "场景实现、可播放 MP4 和生产交接证据"
    ],
    "exclusions": [
      "只改写文案",
      "只给已有视频加字幕",
      "已有实拍素材剪辑",
      "参考视频分析",
      "成片发布后的独立质量审查"
    ]
  },
  "target_platforms": [
    "openai",
    "claude",
    "generic",
    "agent-skills-compatible",
    "vscode"
  ],
  "factory_components": [
    "references",
    "resources",
    "scripts",
    "evals",
    "reports"
  ],
  "skill_os_2_layers": [
    "intent",
    "skill_ir",
    "package",
    "eval",
    "review",
    "operate"
  ],
  "release_gates": [
    "frontmatter",
    "input_output_contract",
    "audio_timeline_contract",
    "resource_route",
    "trigger_eval",
    "timeline_validator",
    "companion_review_handoff",
    "version_report_consistency",
    "root_entrypoint_isolation",
    "evidence_bound_claims"
  ]
}
