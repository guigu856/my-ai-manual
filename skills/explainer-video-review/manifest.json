{
  "name": "explainer-video-review",
  "version": "1.1.0",
  "owner": "guigu856",
  "updated_at": "2026-08-05",
  "status": "active",
  "maturity_tier": "production",
  "lifecycle_stage": "production",
  "context_budget_tier": "production",
  "review_cadence": "on-change",
  "intent": {
    "job_to_be_done": "对已经渲染的口播或概念动效视频建立可复现的证据链，审查视觉表达、空间连续、时序对齐、字幕可读性和技术完整性，并输出修复交接包。",
    "target_users": [
      "知识视频创作者",
      "视频制作代理",
      "成片质量审查者"
    ],
    "inputs": [
      "已渲染 MP4 或可读取的成片视频",
      "冻结文稿、segments.json、timeline.json、字幕和音频（可选但会影响证据完整度）",
      "制作要求、平台规格和重点关注项（可选）"
    ],
    "outputs": [
      "review-manifest.json",
      "review-report.json 和 Markdown 问题摘要",
      "带时间戳、证据、严重级、置信度和修复建议的 finding 清单",
      "生产修复、整片重渲染和复审交接条件"
    ],
    "exclusions": [
      "新建脚本到视频生产",
      "只改写口播稿",
      "已有实拍素材剪辑",
      "参考视频学习和镜头拆解",
      "没有成片输入的通用媒体建议"
    ]
  },
  "target_platforms": [
    "openai",
    "claude",
    "generic",
    "agent-skills-compatible",
    "vscode"
  ],
  "factory_components": [
    "references",
    "scripts",
    "tests",
    "evals",
    "reports"
  ],
  "skill_os_2_layers": [
    "intent",
    "skill_ir",
    "package",
    "eval",
    "review",
    "operate"
  ],
  "release_gates": [
    "frontmatter",
    "input_output_contract",
    "four_dimension_review",
    "sampling_plan",
    "evidence_linkage",
    "report_validator",
    "trigger_eval",
    "repair_handoff",
    "version_report_consistency",
    "root_entrypoint_isolation",
    "evidence_bound_claims"
  ]
}
